# Cloudflare Pages headers — security & caching
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Assets are replaced in place (same file names), so do NOT cache them
# immutably — use a short cache with revalidation so updates show quickly.
/assets/*
  Cache-Control: public, max-age=600, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=86400

# Always revalidate HTML so page changes appear immediately
/*.html
  Cache-Control: public, max-age=0, must-revalidate
